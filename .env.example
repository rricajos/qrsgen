# qrsgen stack — env vars
# Copia este fichero a .env, ajusta valores, y deploya con:
#   docker stack deploy -c docker-compose.yml --resolve-image=changed qrsgen

# === REQUERIDAS ===
PUBLIC_HOSTNAME=qrsgen.example.com
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=CHANGEME
DOWNSTREAM_BASE_URL=https://chat.example.com
DOWNSTREAM_API_TOKEN=CHANGEME

# === OPCIONALES (con default razonable) ===
QRSGEN_VERSION=0.31.1
POSTGRES_PORT=5432
POSTGRES_DB=bridge
POSTGRES_USER=postgres
DOWNSTREAM_ACCOUNT_ID=1
DOWNSTREAM_INBOX_ID=0
INSTANCE_NAME=DEVOPS
DEDUP_ENABLED=true
DEDUP_WINDOW_MS=10000
LOG_LEVEL=info
TRAEFIK_CERTRESOLVER=letsencryptresolver
TRAEFIK_NETWORK=net
