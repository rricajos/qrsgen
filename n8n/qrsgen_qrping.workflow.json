    {
      "parameters": {
        "jsCode": "const items = $json.items || [];\nconst updated = items.filter(i => i.status === 'updated');\nconst missing = items.filter(i => i.status === 'not_found');\nconst lines = [];\nif (updated.length > 0) {\n  lines.push('✅ *Metadata sincronizada* en ' + updated.length + ' contacto(s):');\n  updated.forEach(i => lines.push('  • qrsgen / ' + i.instance));\n}\nif (missing.length > 0) {\n  lines.push('\\n⚠️ *Sin contacto ops* (no existe «qrsgen / X»):');\n  missing.forEach(i => lines.push('  • ' + i.instance + ' — ejecuta /qrv2 ' + i.instance + ' primero'));\n}\nif (updated.length === 0 && missing.length === 0) {\n  lines.push('(sin resultados)');\n}\nlines.push('\\n_Campos sincronizados: nombre, avatar Omnia, empresa Conexia Telecom, país España, descripción._');\nreturn [{ json: { summary: lines.join('\\n') } }];"
